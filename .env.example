# Copy this file to .env and fill in only the providers you use.
# .env is gitignored. Never commit API keys.

# Optional path to a YAML file. Defaults to ./folio.yaml, then ./config.yaml.
# FOLIO_CONFIG=folio.yaml

# Embeddings: sentence-transformers | openai | ollama
FOLIO_EMBEDDING_PROVIDER=sentence-transformers
FOLIO_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Answers: extractive | openai | ollama
# extractive needs no model and quotes the retrieved passages.
FOLIO_LLM_PROVIDER=extractive
FOLIO_LLM_MODEL=llama3.2
# FOLIO_LLM_TEMPERATURE=0.2

# OpenAI-compatible APIs (OpenAI, Groq, LM Studio, Ollama's /v1 shim, ...).
# The key is required only when a provider is set to openai.
FOLIO_OPENAI_API_KEY=
FOLIO_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama native API (not the /v1 shim). Used when a provider is set to ollama.
FOLIO_OLLAMA_BASE_URL=http://localhost:11434

# Vector store: local | chroma
FOLIO_VECTORSTORE_PROVIDER=local
FOLIO_VECTORSTORE_PATH=.folio/store

FOLIO_TOP_K=4
FOLIO_CHUNK_SIZE=800
FOLIO_CHUNK_OVERLAP=120

# Bind address for `folio serve`.
FOLIO_SERVER_HOST=127.0.0.1
FOLIO_SERVER_PORT=8000
